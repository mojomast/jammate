/* aubio config.h — generated by third_party/aubio/CMakeLists.txt.
 *
 * Upstream's waf generates this from host feature checks; this template mirrors
 * the result for a host with no optional audio/FFT/IO backends, so the vendored
 * `src/` stays byte-identical to upstream. Each HAVE_<header>_H line is set by
 * check_include_file() in CMakeLists.txt, exactly as BTrack's CMakeLists does
 * for libsamplerate.
 *
 * Deliberately NOT defined (so aubio falls back to its bundled Ooura FFT and
 * links no external library): HAVE_FFTW3, HAVE_FFTW3F, HAVE_INTEL_IPP,
 * HAVE_ACCELERATE, HAVE_BLAS. Also not defined: HAVE_SNDFILE, HAVE_AVCODEC,
 * HAVE_SWRESAMPLE, HAVE_WAVREAD — the io/ sources that use them are not
 * compiled.
 */
#cmakedefine HAVE_STDLIB_H 1
#cmakedefine HAVE_STDIO_H 1
#cmakedefine HAVE_MATH_H 1
#cmakedefine HAVE_STRING_H 1
#cmakedefine HAVE_ERRNO_H 1
#cmakedefine HAVE_LIMITS_H 1
#cmakedefine HAVE_STDARG_H 1
#cmakedefine HAVE_COMPLEX_H 1
#cmakedefine HAVE_C99_VARARGS_MACROS 1
#cmakedefine HAVE_MEMCPY_HACKS 1
