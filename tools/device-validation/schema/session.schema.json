{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "device-validation/session/1.0",
  "title": "Device-validation session manifest",
  "type": "object",
  "required": ["schema", "session_id", "generated_utc", "synthetic", "product",
               "source", "host", "interfaces", "raw_files", "measurements"],
  "properties": {
    "schema": {"const": "device-validation/session/1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "generated_utc": {"type": "string"},
    "synthetic": {"type": "boolean"},
    "product": {
      "type": "object",
      "required": ["name", "company", "bundle_id"],
      "properties": {
        "name": {"const": "Guitar Companion"},
        "company": {"type": "string"},
        "bundle_id": {"type": "string"},
        "plugin_code": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "git_sha": {"type": ["string", "null"]},
        "build_kind": {"type": "string"}
      }
    },
    "host": {
      "type": "object",
      "required": ["os", "machine"],
      "properties": {
        "os": {"enum": ["windows", "linux", "macos"]},
        "machine": {"type": "string"}
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "os", "backend", "sample_rate", "block_frames"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "os": {"enum": ["windows", "linux", "macos"]},
          "backend": {"type": "string"},
          "driver": {"type": ["string", "null"]},
          "sample_rate": {"type": "integer", "minimum": 1},
          "block_frames": {"type": "integer", "minimum": 1},
          "monitoring": {"enum": ["software-app", "direct-hardware", "unknown"]},
          "reported_input_latency_ms": {"type": ["number", "null"]},
          "reported_output_latency_ms": {"type": ["number", "null"]}
        }
      }
    },
    "target_conditions": {"type": "array", "items": {"type": "string"}},
    "raw_files": {"type": "array"},
    "measurements": {"type": "array"},
    "notes": {"type": "array"}
  }
}
